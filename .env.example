# ── LOCAL DEV ONLY ──────────────────────────────────────────────────────
# Used only by `npx prisma migrate dev` / `npm run dev` against a local
# SQLite file. Production runs on the real Cloudflare D1 database (already
# created — see wrangler.toml) via the D1 binding, not this URL.
DATABASE_URL="file:./local.db"

# ── PRODUCTION (Cloudflare) ─────────────────────────────────────────────
# These are NOT read from this file in production — set them as real
# secrets/vars against your Worker instead:
#
#   npx wrangler secret put NEXTAUTH_SECRET
#   npx wrangler secret put PAYFAST_MERCHANT_ID
#   npx wrangler secret put PAYFAST_MERCHANT_KEY
#   npx wrangler secret put PAYFAST_PASSPHRASE
#
# Non-secret vars (PAYFAST_MODE, NEXTAUTH_URL, NEXT_PUBLIC_SITE_URL) are
# already set in wrangler.toml under [vars] — update the URLs there once
# you know your workers.dev subdomain or custom domain.

# For local `npm run dev` only, you can still set these here:
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PAYMENT_PROVIDER="payfast"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_MODE="sandbox"

# Reserved for future use — no code depends on these yet:
SHIPPING_PROVIDER=""
EMAIL_PROVIDER=""
RESEND_API_KEY=""

# Seed script (local dev only — the real D1 admin account was already
# created directly; email: admin@petvalley.example / password: ChangeMe123!
# — change this password after your first login)
SEED_ADMIN_EMAIL="admin@petvalley.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"
