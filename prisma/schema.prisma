// Pet Valley — Database Schema (Cloudflare D1 / SQLite)
//
// Converted from Postgres for Cloudflare D1 compatibility:
//   - enums          -> String (validated in app code via the literal unions in src/lib/types.ts)
//   - @db.Decimal     -> Float  (D1/SQLite has no native decimal type)
//   - String[] arrays -> String (JSON-encoded; see src/lib/json.ts helpers)
//
// Local dev: `DATABASE_URL="file:./local.db"` + `npx prisma migrate dev`
// Cloudflare: tables are created via the SQL migration run against the real
// D1 database (see migrations/0001_init.sql) — the D1 driver adapter reads
// the binding at runtime, not this url.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- AUTH / USERS ----------
// role: "CUSTOMER" | "ADMIN" | "STAFF"

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  phone         String?
  role          String    @default("CUSTOMER")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cart          Cart?
  couponUsages  CouponUsage[]

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  ordersShipping Order[] @relation("ShippingAddress")
  ordersBilling  Order[] @relation("BillingAddress")

  @@index([userId])
}

// ---------- CATALOG ----------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  petType     String?  // "dog" | "cat" | null (general)
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  products    Product[]
  createdAt   DateTime @default(now())
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  petType        String   // "dog" | "cat" | "both"
  description    String
  features       String   @default("[]") // JSON-encoded string[] — see src/lib/json.ts
  specifications String?
  price          Float
  compareAtPrice Float?
  sku            String   @unique
  stock          Int      @default(0)
  lowStockAt     Int      @default(5)
  tags           String   @default("[]") // JSON-encoded string[]
  images         ProductImage[]
  variants       ProductVariant[]
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  reviews        Review[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
  @@index([petType])
  @@index([isPublished])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      String  @default("image") // "image" | "video"
  altText   String?
  sortOrder Int     @default(0)
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String  // e.g. "Color"
  value       String  // e.g. "Red"
  imageUrl    String? // primary swatch/thumbnail image
  images      String  @default("[]") // JSON-encoded string[] — full gallery for this colour
  priceDelta  Float   @default(0)
  sku         String? @unique
  stock       Int     @default(0)
  sortOrder   Int     @default(0)
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

// ---------- CART ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // for guest carts
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String          @id @default(cuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())

  @@index([cartId])
}

// ---------- WISHLIST ----------

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------- ORDERS ----------
// status: "PENDING" | "PAID" | "PROCESSING" | "SHIPPED" | "IN_TRANSIT" | "OUT_FOR_DELIVERY" | "DELIVERED" | "CANCELLED" | "REFUNDED"
// paymentStatus: "PENDING" | "AUTHORIZED" | "PAID" | "FAILED" | "REFUNDED"

model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  shippingAddressId String
  shippingAddress   Address  @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String
  billingAddress    Address  @relation("BillingAddress", fields: [billingAddressId], references: [id])
  status            String   @default("PENDING")
  paymentStatus     String   @default("PENDING")
  subtotal          Float
  shippingCost      Float    @default(0)
  discountTotal     Float    @default(0)
  taxTotal          Float    @default(0)
  total             Float
  couponCode        String?
  internalNotes     String?
  paymentProofUrl   String?
  items             OrderItem[]
  payment           Payment?
  shipment          Shipment?
  statusHistory     OrderStatusEvent[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Float
}

// ---------- PAYMENTS / SHIPPING ----------
// payment.status: "PENDING" | "AUTHORIZED" | "PAID" | "FAILED" | "REFUNDED"

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  provider    String   // "payfast" | ...
  providerRef String?
  amount      Float
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id])
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
}

// ---------- MARKETING ----------
// type: "PERCENTAGE" | "FIXED" | "FREE_SHIPPING"

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String
  amount        Float    @default(0)
  minOrderValue Float?
  maxDiscount   Float?
  usageLimit    Int?
  timesUsed     Int      @default(0)
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  usages        CouponUsage[]
  createdAt     DateTime @default(now())
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String
  createdAt DateTime @default(now())
}

// ---------- REVIEWS ----------
// status: "PENDING" | "APPROVED" | "REJECTED"

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  authorName String? // overrides the displayed reviewer name (used for admin-added reviews)
  rating     Int
  title      String?
  body       String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([status])
}

// ---------- PASSWORD RESET ----------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- STORE SETTINGS ----------

model StoreSettings {
  id                 String   @id @default("singleton")
  storeName          String   @default("Pet Valley")
  logoUrl            String?
  storeEmail         String?
  supportEmail       String?
  currency           String   @default("USD")
  taxRatePercent     Float    @default(0)
  freeShippingOver   Float?
  flatShippingRate   Float?
  announcementText   String?
  announcementActive Boolean  @default(true)
  socialLinks        String?
  seoDefaultTitle    String?
  seoDefaultDesc     String?
  storeIsLive        Boolean  @default(true)
  heroImageUrl       String?
  heroImageMobileUrl String?
  heroTitle          String?
  heroSubtitle       String?
  heroCtaText        String?
  heroCtaLink        String?
  theme              String   @default("sage")
  manualPaymentEnabled Boolean @default(false)
  bankName           String?
  bankAccountTitle   String?
  bankAccountNumber  String?
  bankIban           String?
  manualPaymentInstructions String?
  updatedAt          DateTime @updatedAt
}
